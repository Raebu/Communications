# Raeburn Connect Supabase production template; contains no credentials.
# Copy to the repository root as .env on the authorised production server.
ENVIRONMENT=production
PUBLIC_URL=https://connect.theraeburngroup.com
SERVICE_HOSTNAME=connect.theraeburngroup.com
DATABASE_URL=
# Set DATABASE_URL privately from the Supabase direct or session-mode connection.
# Use postgresql+psycopg://, TLS verification and the private communications search_path.
# See docs/SUPABASE.md; do not use transaction-mode pooling for this deployment.
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=
REGISTRATION_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_CONNECT=
STRIPE_PRICE_AI=
# A Main Twilio API key is needed for subaccount lifecycle/keys. Standard keys cannot do that.
TWILIO_API_KEY=
TWILIO_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=newphoneline@theraeburngroup.com
EMAIL_REPLY_TO=support@theraeburngroup.com
VERIFICATION_EMAIL_FROM=verification@theraeburngroup.com
COMPANY_REVIEW_EMAIL=verification@theraeburngroup.com
BILLING_EMAIL=billing@theraeburngroup.com
PUBLIC_SALES_ENABLED=false
SMS_MONTHLY_SEGMENTS=100
VOICE_MONTHLY_MINUTES=30
LEGAL_BUSINESS_NAME=
LEGAL_BUSINESS_ADDRESS=
SUPPORT_EMAIL=support@theraeburngroup.com
TERMS_VERSION=
TERMS_URL=
PRIVACY_URL=

# Operator-controlled OpenAI-compatible Chat Completions endpoint. Example private Ollama:
AI_URL=
AI_MODEL=
AI_API_KEY=
AI_DAILY_REQUESTS=100
# Enable only after Twilio ConversationRelay onboarding and a signed WebSocket test.
VOICE_STREAMING_ENABLED=false

# Content minimisation; publish the selected policy before customer onboarding.
MESSAGE_RETENTION_DAYS=90
VOICE_RETENTION_DAYS=30

# Automated verification: no live identity checks until explicitly configured.
COMPANY_VERIFICATION_ENABLED=false
COMPANIES_HOUSE_API_KEY=
# Separate Stripe restricted key with Identity session/report permissions.
STRIPE_IDENTITY_KEY=
VERIFICATION_DAILY_LIMIT=20
VERIFICATION_AUTO_TWILIO=false
PROTECTED_DOMAINS=theraeburngroup.com,techleadersindex.com,globaltechtop10.com
# Optional independently established company number → exact domain bindings.
TRUSTED_COMPANY_DOMAINS={}
